# ==========================================
# OmniRAG — Environment Variables Template
# ==========================================

# --- LLM API Keys ---
# Google Gemini API Key (Get at: https://aistudio.google.com/)
GOOGLE_API_KEY=your_google_api_key_here

# Groq API Key (Get at: https://console.groq.com/)
GROQ_API_KEY=your_groq_api_key_here

# --- LLM Provider & Model Defaults ---
# Options: 'google', 'groq', 'ollama'
DEFAULT_LLM_PROVIDER=google
GOOGLE_MODEL=gemini-1.5-flash
GROQ_MODEL=llama-3.1-8b-instant
OLLAMA_MODEL=llama3.2
OLLAMA_BASE_URL=http://localhost:11434

# --- Embedding & Vector Store Settings ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
VECTOR_DB_PATH=./vector_store
COLLECTION_NAME=omnirag_collection
TOP_K=5

# --- Document Chunking Settings ---
DEFAULT_CHUNK_SIZE=1000
DEFAULT_CHUNK_OVERLAP=200

# --- OCR & Ingestion Settings ---
OCR_MIN_TEXT_LENGTH=50
OCR_LANGUAGE=eng

# --- System & Logging ---
LOG_LEVEL=INFO
